Chare(int cIdx, int eIdx, void *msg, CkChareID *pCid, int destPE)\n   _TRACE_CREATION_DONE(1);\n }\n \n+/* Local pilot fix: honor the 64-byte alignment required by SpECTRE's\n+ * MultiReaderSpinlock. Group registration records size, but not alignment.\n+ * posix_memalign storage is compatible with Chare::operator delete/free.\n+ */\n+static inline void *CkAllocGroupObject(size_t size)\n+{\n+  void *obj = NULL;\n+  if (posix_memalign(&obj, 64, size) != 0)\n+    CmiAbort(\"Unable to allocate aligned group object\");\n+  return obj;\n+}\n+\n void CkCreateLocalGroup(CkGroupID groupID, int epIdx, envelope *env)\n {\n   int gIdx = _entryTable[epIdx]->chareIdx;\n-  void *obj = malloc(_chareTable[gIdx]->size);\n+  void *obj = CkAllocGroupObject(_chareTable[gIdx]->size);\n   _MEMCHECK(obj);\n   setMemoryTypeChare(obj);\n   CmiImmediateLock(CkpvAccess(_groupTableImmLock));\n@@ -697,7 +709,7 @@ void CkCreateLocalNodeGroup(CkGroupID groupID, int epIdx, envelope *env)\n {\n   int gIdx = _entryTable[epIdx]->chareIdx;\n   size_t objSize=_chareTable[gIdx]->size;\n-  void *obj = malloc(objSize);\n+  void *obj = CkAllocGroupObject(objSize);\n   _MEMCHECK(obj);\n   setMemoryTypeChare(obj);\n   CkpvAccess(_currentGroup) = groupID;\n", "wall_seconds": 50.00292116194032}
