  "CMakeLists.txt": [
    "include(SpectreGetGitHash)",
    "# We need Python in the build system and throughout the code. Setting it up",
    "# early so we can rely on a consistent Python version in the build system.",
    "option(ENABLE_PYTHON \"Enable Python\" ON)",
    "if (ENABLE_PYTHON)",
    "  find_package(Python 3.10 REQUIRED)",
    "  # Define the location of Python code in the build directory. Unit tests etc. can",
    "  # add this location to their `PYTHONPATH`.",
    "  set(SPECTRE_PYTHON_PREFIX_PARENT \"${CMAKE_BINARY_DIR}/bin/python\")",
    "    SPECTRE_PYTHON_PREFIX_PARENT \"${SPECTRE_PYTHON_PREFIX_PARENT}\" ABSOLUTE)",
    "  # Extract the site-packages directory. Python installations can have different",
    "  # `dist-packages` instead of `site-packages`), so we query Python for the",
    "  # correct location and fix the `Python_SITELIB` variable. CMake's `FindPython`",
    "      COMMAND \"${Python_EXECUTABLE}\" -c \"import sys, sysconfig;\\",
    "    list(GET _SITELIB_PATHS 0 PYTHON_TRUE_SITELIB)",
    "    if (NOT Python_SITELIB STREQUAL PYTHON_TRUE_SITELIB)",
    "      set(Python_SITELIB \"${PYTHON_TRUE_SITELIB}\" CACHE PATH FORCE",
    "        \"Corrected Python site-packages directory\")",
    "        \"Corrected Python site-packages directory: ${Python_SITELIB}\")",
    "    list(GET _SITELIB_PATHS 1 SPECTRE_PYTHON_SITE_PACKAGES)",
    "    message(WARNING \"Failed to determine Python site-packages directory, \"",
    "      \"using default value: ${Python_SITELIB}\")",
    "    set(SPECTRE_PYTHON_SITE_PACKAGES \"${CMAKE_BINARY_DIR}/lib/\\",
    "python${Python_VERSION_MAJOR}.${Python_VERSION_MINOR}/site-packages\")",
    "  set(PYTHONPATH \"${SPECTRE_PYTHON_PREFIX_PARENT}:\\",
    "${SPECTRE_PYTHON_SITE_PACKAGES}\")",
    "  if(DEFINED ENV{PYTHONPATH})",
    "    set(PYTHONPATH \"${PYTHONPATH}:$ENV{PYTHONPATH}\")",
    "  message(STATUS \"PYTHONPATH: ${PYTHONPATH}\")",
    "  # We still need minimal Python for linking purpose.",
    "  find_package(Python REQUIRED)",
    "option(USE_PCH \"Use precompiled headers\" ON)",
    "include(SetupGitHooks)",
    "include(SetupCharm)",
    "# In order to use certain code analysis tools like clang-tidy and cppcheck the",
    "# alternative we set it up early too. Finally, Blaze uses the GSL",
    "include(SetupLIBCXXCharm)",
    "if (USE_PCH)",
    "  include(SetupPch)",
    "# after the PCH setup because that way they are able to change their",
    "# dependencies on the PCH if necessary.",
    "include(SpectreSetupPythonPackage)",
    "# Charm++ generated headers are created in the build directory",
    "# (by `add_charm_module`)"
  ],
  "cmake/SetupPch.cmake": [
    "# Support for precompiled headers (PCH)",
    "# We have the following requirements on the PCH:",
    "# - the correct flags to include the PCH must be propagated to any targets",
    "#   that use the PCH.",
    "# We use CMake's PCH support to accomplish this. It is documented here:",
    "# The PCH is generated by compiling a source file that includes all the headers",
    "# `tools/SpectrePch.hpp`.",
    "# Instructions for using the PCH:",
    "# Targets can use the PCH generated for the `SpectrePch` library. They must also",
    "# link the `SpectrePchFlags` library so they compile with the same flags as the",
    "# PCH. Make sure to check the PCH exist before using them:",
    "#     if(TARGET SpectrePch)",
    "#       target_precompile_headers(${TARGET_NAME} REUSE_FROM SpectrePch)",
    "#       target_link_libraries(${TARGET_NAME} PRIVATE SpectrePchFlags)",
    "# This library tracks all compiler flags to build the PCH. Targets that use",
    "# the PCH must link this library so they compile with the same flags as the",
    "# PCH.",
    "add_library(SpectrePchFlags INTERFACE)",
    "  SpectrePchFlags",
    "  Charmxx::charmxx",
    "  Charmxx::pup",
    "# Targets can reuse the PCH generated for this library. They must also link",
    "# the `SpectrePchFlags` library. Notes:",
    "# - We store the PCH header in ${CMAKE_SOURCE_DIR}/tools so that it is not",
    "# - We also store a source file that just includes the PCH header so the",
    "#   only need to build it so it generates the PCH.",
    "  ${CMAKE_SOURCE_DIR}/tools/SpectrePch.hpp",
    "set(SPECTRE_PCH_HEADER ${CMAKE_BINARY_DIR}/SpectrePch.hpp)",
    "  OUTPUT ${CMAKE_BINARY_DIR}/SpectrePch.cpp",
    "  CONTENT \"#include \\\"${SPECTRE_PCH_HEADER}\\\"\\n\")",
    "  SpectrePch",
    "  ${CMAKE_BINARY_DIR}/SpectrePch.cpp)",
    "  SpectrePch",
    "  ${SPECTRE_PCH_HEADER}",
    "  SpectrePch",
    "  SpectrePchFlags"
  ]
}
