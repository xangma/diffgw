+/* Local pilot fix: honor the 64-byte alignment required by SpECTRE's
+ * MultiReaderSpinlock. Group registration records size, but not alignment.
+ * posix_memalign storage is compatible with Chare::operator delete/free.
+ */
+static inline void *CkAllocGroupObject(size_t size)
+{
+  void *obj = NULL;
+  if (posix_memalign(&obj, 64, size) != 0)
+    CmiAbort("Unable to allocate aligned group object");
+  return obj;
+}
