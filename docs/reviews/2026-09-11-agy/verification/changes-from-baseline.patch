+    assert suite_res["catalog_coverage"]["SEOBNR_ROM"]["status"] == "UNRESOLVED_ORACLE"
+    assert suite_res["catalog_coverage"]["KerrRingdown"]["status"] == "UNRESOLVED_ORACLE"
+
