{
  "metadata": {
    "python": "/Users/xangma/miniconda3/envs/pycbcorig313/bin/python",
    "qnm_unit_conversion": "evaluate_kerr_qnm_220 gives M_final*omega; remnant_properties wants M_total*f, so factor=(m1+m2)/(M_final*2*pi)",
    "unit_assertion": true,
    "source_sha256": {
      "scripts/nsbh_spin_convention_diagnostic.py": "4944b83d5d2b172204de672ac05bc2321f5315369d4eded3deee6a0f3fc7bb66",
      "src/torchwave/approximants/imrphenom_nsbh.py": "82ed5e2d4ed7af6161e3898b2eeab793172ce245f9449acbaaf8c4215c98b179",
      "src/torchwave/approximants/imrphenomd.py": "d33cdf095aa5d7803e9c1d201e8c3599991227f9a904116860a36b469ac424f0"
    },
    "hook_restored": true,
    "public_callable_inventory": {
      "torchwave.approximants.imrphenomd.evaluate_kerr_qnm_220": {
        "signature": "(a_final: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]",
        "doc": "Return Re(M_f*omega) and -Im(M_f*omega), preserving shape/device/dtype.\n\nNegative spin uses the positive-spin m=-2 branch by Kerr symmetry. Inputs\noutside [-0.9999, 0.9999] retain the historical endpoint-clamping behavior."
      },
      "torchwave.approximants.imrphenom_nsbh.NSBHPhaseBaseline": {
        "signature": "(final_spin: torch.Tensor)",
        "doc": "PhenomD phase baseline using the NSBH supplied final spin.\n\nThe mass remains the documented Husa PhenomD remnant mass.  Kerr QNM\noutputs are converted from ``M_f omega`` to the PhenomD convention\n``M_total f`` using the public component contracts."
      },
      "torchwave.approximants.imrphenom_nsbh._legacy_phase_offsets": {
        "signature": "(m1, m2, s1, s2, mf_ref, mf_anchor, remnant_mass, remnant_spin)",
        "doc": "Retain the inherited NSBH affine gauge, not a published prescription.\n\nIts constant uses the inspiral phase at the reference frequency; its time\norigin uses the raw MR slope at the requested upper frequency, evaluated\nwith the amplitude remnant. These offsets do not alter intrinsic curvature."
      },
      "torchwave.approximants.imrphenom_nsbh.evaluate_kerr_qnm_220": {
        "signature": "(a_final: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]",
        "doc": "Return Re(M_f*omega) and -Im(M_f*omega), preserving shape/device/dtype.\n\nNegative spin uses the positive-spin m=-2 branch by Kerr symmetry. Inputs\noutside [-0.9999, 0.9999] retain the historical endpoint-clamping behavior."
      },
      "torchwave.approximants.imrphenom_nsbh.nrtidalv2_frequency_phase": {
        "signature": "(frequency_hz: torch.Tensor, total_mass_sec: torch.Tensor, eta: torch.Tensor, lambda_tilde: torch.Tensor) -> torch.Tensor",
        "doc": "Return the additive NRTidalv2 phase correction in radians.\n\n``frequency_hz`` is the positive GW (2,2) frequency.  The tidal\ndeformability is the usual mass-weighted ``Lambda_tilde``.  No reference\nphase or time shift is applied here: those affine choices belong to the\nPhenomD baseline in the NSBH assembly (Thompson et al. Sec. II.B)."
      },
      "lalsimulation.SimIMRPhenomNSBHProperties": {
        "signature": "builtin (inspect.signature unavailable)",
        "doc": "SimIMRPhenomNSBHProperties(REAL8 mBH_SI, REAL8 mNS_SI, REAL8 chi_BH, REAL8 lambda_NS) -> int"
      },
      "lalsimulation.SimIMRPhenomDFinalSpin": {
        "signature": "builtin (inspect.signature unavailable)",
        "doc": "SimIMRPhenomDFinalSpin(REAL8 const m1_in, REAL8 const m2_in, REAL8 const chi1_in, REAL8 const chi2_in) -> double"
      },
      "lalsimulation.SimPhenomUtilsIMRPhenomDFinalMass": {
        "signature": "builtin (inspect.signature unavailable)",
        "doc": "SimPhenomUtilsIMRPhenomDFinalMass(REAL8 m1, REAL8 m2, REAL8 chi1z, REAL8 chi2z) -> double"
      }
    }
  },
